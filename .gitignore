.venv/
__pycache__/
.pytest_cache/
*.egg-info/
third_party/menagerie_source/
.publish/
.planning_library/
.env
.env.*
*.pem
*.key

# Full generated history is preserved in the GitHub Release archives.
/results/*
!/results/README.md
!/results/*.json
!/results/perception_sensor_model/
!/results/perception_cycle_preflight/
!/results/github_publication/
!/results/factory_acceptance/
/results/factory_acceptance/*
!/results/factory_acceptance/BENCHMARK.json
!/results/factory_acceptance/progress.json
!/results/factory_acceptance/run_00/
/results/factory_acceptance/run_00/contacts.json
!/results/factory_contact/
/results/factory_contact/contacts.json
!/results/factory_video/
/results/factory_video/episode/*
!/results/factory_video/episode/config.json
/results/factory_video/*.mp4

# Keep presentation source, images and the final PDF, not compiler intermediates.
/presentation_beamer/**/*.aux
/presentation_beamer/**/*.log
/presentation_beamer/**/*.nav
/presentation_beamer/**/*.out
/presentation_beamer/**/*.snm
/presentation_beamer/**/*.toc
/presentation_beamer/**/*console*.txt
/presentation_beamer/main.pdf
/presentation_beamer/preview/
/presentation_beamer/presentation_beamer/
/presentation_beamer/latex_sources.zip
